# Netlify – Antwort-Header (Format: https://docs.netlify.com/routing/headers/). Wird unverändert nach out/_headers kopiert.
# Strenge CSP nur für die Marketing- und Rechtsseiten (kein Laufzeit-JS außer eigenem, keine fremden Hosts).
# /app/ (Flutter-Web), /auth/confirm/ und /c/ sprechen mit Supabase und laden Cover → dort keine CSP von hier.
# Cache-Control nur für gehashte Dateien setzen (Netlify führt gleichnamige Header mehrerer Regeln zusammen);
# alles andere behält Netlifys Standard „public, max-age=0, must-revalidate“.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000

/
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin

/de/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin

/imprint/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

/badges/*
  Cache-Control: public, max-age=86400

/og/*
  Cache-Control: public, max-age=86400
